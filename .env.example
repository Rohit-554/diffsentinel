# DiffSentinel environment variables.
# Copy to .env for local overrides. Never commit .env.
# Every value below is a local development default, not a real secret.

# --- Docker Compose: PostgreSQL container ---
# Credentials for the local database container only.
POSTGRES_USER=diffsentinel
POSTGRES_PASSWORD=diffsentinel
POSTGRES_DB=diffsentinel
# Host ports for the database containers (bound to 127.0.0.1 only).
# PostgreSQL uses 5433 so it doesn't clash with a locally installed PostgreSQL on 5432.
POSTGRES_HOST_PORT=5433
REDIS_HOST_PORT=6379

# --- API (apps/api) ---
# Values below target services running on the host (pnpm dev).
# Docker Compose sets its own container-network URLs for the API.
# Required. PostgreSQL connection URL (postgres:// or postgresql://).
DATABASE_URL=postgresql://diffsentinel:diffsentinel@localhost:5433/diffsentinel
# Required. Redis connection URL (redis:// or rediss://). Shared with the reviewer.
REDIS_URL=redis://localhost:6379
# Optional. HTTP port for the API. Default: 3000.
API_PORT=3000
# Optional. fatal | error | warn | info | debug | verbose. Default: info. Shared with the reviewer.
LOG_LEVEL=info
# Optional. development | test | production. Default: development.
NODE_ENV=development
# Optional. Session lifetime in hours (1-24). Default: 8.
SESSION_TTL_HOURS=8

# --- GitHub App (sign-in and installation) ---
# Set all four to enable "Sign in with GitHub", or leave all empty to run
# without it (sign-in then reports "not configured"). Setting only some is a
# startup error. See "GitHub App setup (development)" in README.md.
# Client ID of the GitHub App (not the App ID).
GITHUB_APP_CLIENT_ID=
# Client secret of the GitHub App. Secret: never commit a real value.
GITHUB_APP_CLIENT_SECRET=
# The App's URL name, as in https://github.com/apps/<slug>.
GITHUB_APP_SLUG=
# Origin the browser uses to reach DiffSentinel, without a path.
# Compose: http://localhost:8080. Vite dev server: http://localhost:5173.
PUBLIC_BASE_URL=

# --- Reviewer (services/reviewer) ---
# Also reads REDIS_URL (required) and LOG_LEVEL from above.
# Optional. HTTP port for the reviewer's health endpoints. Default: 8000.
REVIEWER_PORT=8000

# --- Web (apps/web) ---
# Optional. Where the Vite dev server proxies /api. Default: http://localhost:3000.
# Only the dev server reads it. Never put secrets in VITE_* variables: Vite can expose them to browser code.
VITE_API_PROXY_TARGET=http://localhost:3000
